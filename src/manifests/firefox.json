{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "short_name": "Vitreous",
    "version": "1.0.0",
    "description": "__MSG_extensionDesc__",
    "author": "Vitreous",
    "default_locale": "en",
    "icons": {
        "128": "src/assets/favicons/favicon-128x128.png"
    },
    "chrome_settings_overrides": {
        "homepage": "index.html"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "action": {
        "default_icon": {
            "128": "src/assets/favicons/favicon-128x128.png"
        },
        "default_title": "__MSG_extensionName__"
    },
    "background": {
        "scripts": [
            "src/scripts/service-worker.js"
        ]
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://suggestqueries.google.com/*",
        "https://duckduckgo.com/*",
        "https://s2.googleusercontent.com/*",
        "https://zenquotes.io/*",
        "https://picsum.photos/*",
        "https://cdn.jsdelivr.net/*"
    ],
    "optional_permissions": [
        "bookmarks",
        "topSites",
        "search"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "{4f391a9e-8717-4ba6-a5b1-488a34931fcb}",
            "strict_min_version": "109.0"
        }
    }
}
